DATABASE_URL=postgres://user:password@host:5432/shelby_hub?sslmode=require
NEXT_PUBLIC_REGISTRY_ADDRESS=0xLEGACY_V1_ADDRESS
NEXT_PUBLIC_REGISTRY_V2_ADDRESS=0xREGISTRY_V2_ADDRESS
NEXT_PUBLIC_REGISTRY_V2_SHELBYNET_ADDRESS=0xREGISTRY_V2_SHELBYNET_ADDRESS
APTOS_INDEXER_URL=https://api.testnet.aptoslabs.com/v1/graphql
SHELBYNET_INDEXER_URL=https://api.shelbynet.shelby.xyz/v1/graphql
# Legacy read support for reports registered with encryption version 2:
NEXT_PUBLIC_ACE_APP_ORIGIN=https://shelbyscribe.vercel.app
NEXT_PUBLIC_ACE_DEPLOYMENT_NAME=preview20260610
# Use these instead of NEXT_PUBLIC_ACE_DEPLOYMENT_NAME for a self-managed legacy ACE deployment:
# NEXT_PUBLIC_ACE_API_ENDPOINT=https://api.testnet.aptoslabs.com/v1
# NEXT_PUBLIC_ACE_CONTRACT_ADDRESS=0xACE_CONTRACT_ADDRESS
# NEXT_PUBLIC_ACE_KEYPAIR_ID=0xACE_IBE_KEYPAIR_ID
# NEXT_PUBLIC_ACE_CHAIN_ID=2
# NEXT_PUBLIC_ACE_API_KEY=
# Generate with: openssl rand -base64 32
PREMIUM_MASTER_KEY_VERSION=1
PREMIUM_MASTER_KEY_V1=replace-with-a-base64-encoded-32-byte-key
# Legacy AWS-wrapped report reads only. New uploads do not use AWS KMS.
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
CRON_SECRET=replace-with-at-least-32-random-bytes
COINGECKO_API_KEY=
